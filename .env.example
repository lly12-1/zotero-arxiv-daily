# Zotero: create a read-only API key at https://www.zotero.org/settings/keys
ZOTERO_ID=9359764
ZOTERO_KEY=your_read_only_zotero_api_key

# SMTP email delivery
SENDER=321675640@qq.com
RECEIVER=lly1225425@163.com
SENDER_PASSWORD=your_smtp_app_password
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465

# DeepSeek OpenAI-compatible endpoint
OPENAI_API_KEY=your_api_key
OPENAI_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
HF_HUB_DISABLE_XET=1

# Optional. Public PubMed access works without it; a key only raises NCBI rate limits.
NCBI_API_KEY=

# Set true only for a limited test run
DEBUG=false
